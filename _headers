# Cloudflare Pages response headers.
# - frame-ancestors / X-Frame-Options stop other sites from wrapping KAPRAO in a frame.
# - The CSP only allows our own code plus the services we use (fonts, map tiles, Supabase).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.supabase.co https://api.maptiler.com; connect-src 'self' blob: https://*.supabase.co wss://*.supabase.co; media-src 'self' blob: https://*.supabase.co https://*.cloudflarestream.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
